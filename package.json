{
  "name": "preact-starter",
  "type": "module",
  "version": "1.0.0",
  "description": "Barebones starter for a preact project",
  "main": "dist/index.js",
  "scripts": {
    "build": "vite build",
    "serve": "vite preview",
    "start": "vite",
    "test": "vitest",
    "lint": "pnpm run tsc && pnpm run check-format",
    "tsc": "tsc -b tsconfig.json",
    "check-format": "prettier --ignore-unknown --check .",
    "format": "prettier --ignore-unknown --write .",
    "prepare": "node scripts/prepare.ts"
  },
  "nano-staged": {
    "*": "prettier --ignore-unknown --write --"
  },
  "author": "Andre Wiggins",
  "license": "MIT",
  "dependencies": {
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "4.1.10",
    "happy-dom": "^20.14.5",
    "nano-staged": "^1.0.2",
    "prettier": "^3.9.6",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@12.9.1",
  "volta": {
    "node": "26.10.0"
  }
}
